<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Calametra.Ingestion — the second host.

    This project is the reason Calametra qualifies for Design 3 at all
    (design_3 §3: "a layer must be reused by a second host"). It re-uses
    Calametra.Application to run scheduled ingestion of USGS / PHIVOLCS /
    IBTrACS data without touching the HTTP request path.

    It is a peer of Calametra.Api, not a child of it.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Calametra.Application\Calametra.Application.csproj" />
    <ProjectReference Include="..\Calametra.Infrastructure\Calametra.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>
