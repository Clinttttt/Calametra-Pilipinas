<Project>

  <!--
    Central Package Management. Every version is declared once, here.
    All versions verified against api.nuget.org on 2026-09-04 and pinned exactly.

    Deliberate omission: MediatR.
    MediatR 13+ is RPL-1.5 / commercially licensed (14.2.0 is the current line).
    Calametra ships a hand-written dispatcher in Calametra.Application/Abstractions/Messaging
    instead. See docs/adr/ADR-001-no-mediatr.md.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Domain">
    <!-- Geometry value types. The single package permitted in Calametra.Domain.
         See docs/adr/ADR-002-geometry-in-domain.md -->
    <PackageVersion Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <!-- snake_case column naming so the database is readable in psql without quoting. -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <!--
      Reads the PSA's PSGC publication, which is distributed as an .xlsx workbook.

      Taken so the operator can point the importer at the PSA file ITSELF: ADR-005 gate 1 requires the
      edition to be a cited PSA publication, and the SHA-256 recorded against it has to be the hash of
      the bytes the PSA served. Asking an operator to convert the workbook to CSV first would break that
      chain — the hash would then describe a file the PSA never published.

      MIT licensed. Pinned exactly, as everything here is.
    -->
    <PackageVersion Include="ClosedXML" Version="0.104.2" />

    <!--
      OsmSharp reads the Geofabrik .osm.pbf extract.

      A PBF is protobuf-framed, delta-encoded and zlib-compressed per block, so parsing it by hand would
      be a few hundred lines of format handling for no benefit. The alternative was the Overpass API, and
      that route is closed: measured on 2026-09-15 the public gateway returns 504 at about 31 seconds for
      every query formulation tried, which national boundary geometry cannot fit inside.

      MIT licensed. Pinned exactly, as everything here is.
    -->
    <PackageVersion Include="OsmSharp" Version="6.2.0" />

    <!--
      NetTopologySuite.IO.ShapeFile reads the OCHA COD-AB boundary set.

      HDX publishes it as an ESRI shapefile and a GeoJSON of comparable size; the shapefile is read because
      its .dbf gives the attribute table without parsing a gigabyte of coordinates to find the PSGC codes,
      which is what the correspondence review needs before any geometry is imported at all.

      BSD-3-Clause, from the same project as the NetTopologySuite already in use here. Pinned exactly.
    -->
    <PackageVersion Include="NetTopologySuite.IO.ShapeFile" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup Label="Hosts">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- Shouldly, not FluentAssertions: FA v8 moved to a paid licence. -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

</Project>
